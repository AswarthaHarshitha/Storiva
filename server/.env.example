# PostgreSQL connection string. Locally: a database you created with `createdb storiva`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/storiva"

# Port the API listens on. Render sets this automatically in production.
PORT=4000

# "production" enables Secure cookies, trusts the hosting proxy and serves the built web app.
NODE_ENV=development

# How long a login lasts, in days.
SESSION_TTL_DAYS=7

# Production only: how many reverse proxies sit in front of the server (2 on Render:
# Cloudflare and Render's load balancer). Used to find the real client IP for rate limiting.
TRUST_PROXY_HOPS=1
