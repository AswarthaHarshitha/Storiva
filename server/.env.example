# PostgreSQL connection string. Locally: a database you created with `createdb stockflow`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stockflow"

# Port the API listens on. Render sets this automatically in production.
PORT=4000

# "production" enables Secure cookies, trusts the hosting proxy and serves the built web app.
NODE_ENV=development

# How long a login lasts, in days.
SESSION_TTL_DAYS=7
