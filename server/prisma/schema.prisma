generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                       String           @id @default(uuid()) @db.Uuid
  name                     String           @db.VarChar(120)
  defaultLowStockThreshold Int              @default(5) @map("default_low_stock_threshold")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                    User[]
  products                 Product[]
  barcodes                 ProductBarcode[]
  stockMovements           StockMovement[]

  evidence     ProductEvidence[]
  suppliers    Supplier[]
  receipts     Receipt[]
  receiptLines ReceiptLine[]
  imports      ImportBatch[]
  exceptions   InventoryException[]

  @@map("organizations")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(254)
  passwordHash    String           @map("password_hash")
  organizationId  String           @map("organization_id") @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions        Session[]
  updatedProducts Product[]        @relation("ProductLastUpdatedBy")
  barcodes        ProductBarcode[]
  stockMovements  StockMovement[]
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  evidence        ProductEvidence[]
  receiptsCreated Receipt[]         @relation("ReceiptCreatedBy")
  imports         ImportBatch[]

  @@index([organizationId])
  @@map("users")
}

// Server-side sessions. Only a SHA-256 hash of the cookie token is stored, so a leaked
// database row cannot be replayed as a login.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// SKU uniqueness is case-insensitive per organization; it is enforced by the
// products_organization_id_sku_key expression index created in the migration SQL,
// because Prisma cannot declare an index on lower(sku).
model Product {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String           @db.VarChar(200)
  sku                  String           @db.VarChar(64)
  description          String?          @db.VarChar(2000)
  quantityOnHand       Int              @default(0) @map("quantity_on_hand")
  costPrice            Decimal?         @map("cost_price") @db.Decimal(12, 2)
  sellingPrice         Decimal?         @map("selling_price") @db.Decimal(12, 2)
  lowStockThreshold    Int?             @map("low_stock_threshold")
  brand                String?          @db.VarChar(120)
  manufacturer         String?          @db.VarChar(200)
  category             String?          @db.VarChar(200)
  imageUrl             String?          @map("image_url") @db.VarChar(500)
  // Set when the product was created from a catalogue result: which catalogue and when.
  catalogueProvider    String?          @map("catalogue_provider") @db.VarChar(40)
  catalogueSourceName  String?          @map("catalogue_source_name") @db.VarChar(60)
  catalogueRetrievedAt DateTime?        @map("catalogue_retrieved_at") @db.Timestamptz(3)
  lastAdjustmentNote   String?          @map("last_adjustment_note") @db.VarChar(200)
  lastUpdatedById      String?          @map("last_updated_by_id") @db.Uuid
  lastUpdatedBy        User?            @relation("ProductLastUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  barcodes             ProductBarcode[]
  stockMovements       StockMovement[]
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  evidence     ProductEvidence[]
  receiptLines ReceiptLine[]
  exceptions   InventoryException[]

  @@index([organizationId, name])
  @@map("products")
}

enum BarcodeKind {
  gtin // EAN-8, EAN-13, UPC-A/E or GTIN-14, check digit verified; UPC-A/E stored as GTIN-13
  other // any other symbology (Code 128, Code 39, QR, ...), stored as scanned

  @@map("barcode_kind")
}

// A product can carry several codes (e.g. the manufacturer's EAN and a supplier's code).
// `code` is the normalized form used for lookups; `rawCode` is what was scanned or typed.
model ProductBarcode {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id") @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  code           String       @db.VarChar(200)
  rawCode        String       @map("raw_code") @db.VarChar(200)
  kind           BarcodeKind
  createdById    String?      @map("created_by_id") @db.Uuid
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@index([productId])
  @@map("product_barcodes")
}

enum StockMovementType {
  create
  edit
  adjust
  receive
  issue
  count

  @@map("stock_movement_type")
}

enum StockMovementSource {
  manual
  camera
  scanner
  import
  receiving
  copilot

  @@map("stock_movement_source")
}

// Append-only record of every change to a product's quantity. The product name and SKU are
// copied so history stays readable after a product is deleted.
model StockMovement {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String?             @map("product_id") @db.Uuid
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku     String              @map("product_sku") @db.VarChar(64)
  productName    String              @map("product_name") @db.VarChar(200)
  type           StockMovementType
  source         StockMovementSource
  quantityBefore Int                 @map("quantity_before")
  quantityChange Int                 @map("quantity_change")
  quantityAfter  Int                 @map("quantity_after")
  note           String?             @db.VarChar(200)
  userId         String?             @map("user_id") @db.Uuid
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  idempotencyKey String?             @map("idempotency_key") @db.VarChar(64)
  // The document that caused this movement, e.g. a receipt or an import batch.
  referenceType  String?             @map("reference_type") @db.VarChar(20)
  referenceId    String?             @map("reference_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

// Cached answers from public product catalogues, keyed by provider and GTIN. This holds only
// public catalogue data (never organization data), so it is shared between organizations.
model CatalogueEntry {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   @db.VarChar(40)
  code       String   @db.VarChar(14)
  found      Boolean
  data       Json?
  sourceName String?  @map("source_name") @db.VarChar(60)
  sourceUrl  String?  @map("source_url") @db.VarChar(500)
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@unique([provider, code])
  @@map("catalogue_entries")
}

enum EvidenceStatus {
  verified // checked by a person (physical count, explicit confirmation)
  documented // taken from a business document, e.g. a supplier receipt
  entered // typed or imported by a user
  unverified // retrieved from an external catalogue

  @@map("evidence_status")
}

// Where a product's important fields came from. Append-only; the newest row per field is the
// current origin. Products created before this table existed have no rows: their origin is
// unknown and is shown that way rather than reconstructed.
model ProductEvidence {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String         @map("product_id") @db.Uuid
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  field          String         @db.VarChar(30)
  value          String?        @db.VarChar(500)
  source         String         @db.VarChar(30)
  status         EvidenceStatus
  detail         String?        @db.VarChar(200)
  referenceType  String?        @map("reference_type") @db.VarChar(20)
  referenceId    String?        @map("reference_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, productId, field, createdAt])
  @@map("product_evidence")
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(120)
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(40)
  notes          String?      @db.VarChar(1000)
  receipts       Receipt[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("suppliers")
}

enum ReceiptStatus {
  draft
  confirmed

  @@map("receipt_status")
}

// A delivery being received: typed in, or read from an invoice photo and then reviewed.
model Receipt {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?       @map("supplier_id") @db.Uuid
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reference      String?       @db.VarChar(80)
  documentDate   DateTime?     @map("document_date") @db.Date
  expectedDate   DateTime?     @map("expected_date") @db.Date
  status         ReceiptStatus @default(draft)
  source         String        @default("manual") @db.VarChar(20)
  // The text read from an invoice photo, kept for review. The image itself is not stored.
  documentText   String?       @map("document_text")
  totalAmount    Decimal?      @map("total_amount") @db.Decimal(12, 2)
  notes          String?       @db.VarChar(1000)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdBy      User?         @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById  String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  lines          ReceiptLine[]
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([supplierId])
  @@map("receipts")
}

model ReceiptLine {
  id               String       @id @default(uuid()) @db.Uuid
  receiptId        String       @map("receipt_id") @db.Uuid
  receipt          Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id") @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String?      @map("product_id") @db.Uuid
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  position         Int
  description      String       @db.VarChar(300)
  expectedQuantity Int?         @map("expected_quantity")
  receivedQuantity Int          @map("received_quantity")
  damagedQuantity  Int          @default(0) @map("damaged_quantity")
  unitCost         Decimal?     @map("unit_cost") @db.Decimal(12, 2)
  updateCost       Boolean      @default(false) @map("update_cost")
  matchConfidence  String?      @map("match_confidence") @db.VarChar(10)

  @@index([receiptId])
  @@index([organizationId, productId])
  @@map("receipt_lines")
}

model ImportBatch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String       @map("file_name") @db.VarChar(200)
  createdCount   Int          @map("created_count")
  updatedCount   Int          @map("updated_count")
  adjustedCount  Int          @map("adjusted_count")
  skippedCount   Int          @map("skipped_count")
  // Rows left out of the import and why: [{ row, field, message }]
  errors         Json
  userId         String?      @map("user_id") @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("import_batches")
}

enum ExceptionStatus {
  open
  resolved
  dismissed

  @@map("exception_status")
}

// A problem worth a person's attention, detected from recorded data. dedupeKey stops the same
// finding being raised twice.
model InventoryException {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String          @db.VarChar(40)
  dedupeKey      String          @map("dedupe_key") @db.VarChar(200)
  productId      String?         @map("product_id") @db.Uuid
  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String          @db.VarChar(200)
  detail         Json
  status         ExceptionStatus @default(open)
  resolutionNote String?         @map("resolution_note") @db.VarChar(500)
  resolvedById   String?         @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
  @@map("inventory_exceptions")
}
